{
  "name": "resume-forge",
  "private": true,
  "version": "0.1.0",
  "description": "PDF 简历解析 + 可视化编辑 + 一键导出的纯前端工作台",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "resume",
    "cv",
    "pdf",
    "parser",
    "resume-builder",
    "pdfjs",
    "react",
    "typescript"
  ],
  "scripts": {
    "setup:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "npm run setup:pdfjs",
    "dev": "vite",
    "prebuild": "npm run setup:pdfjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
